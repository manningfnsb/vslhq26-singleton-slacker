<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PolicyProof</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PolicyProof.styles.css" asp-append-version="true" />
    <script>
        (function() {
            var t = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
    <style>
        [data-bs-theme="dark"] .assessment-banner { background: #1e3a5f !important; border-color: #2d4a6f !important; }
        [data-bs-theme="dark"] .assessment-banner h5, [data-bs-theme="dark"] .assessment-banner span,
        [data-bs-theme="dark"] .assessment-banner strong, [data-bs-theme="dark"] .assessment-banner small,
        [data-bs-theme="dark"] .assessment-banner div { color: #bfdbfe !important; }
        [data-bs-theme="dark"] .upload-header { background: #1e3a5f !important; border-color: #2d4a6f !important; color: #bfdbfe !important; }
        [data-bs-theme="dark"] .upload-header h4, [data-bs-theme="dark"] .upload-header small { color: #bfdbfe !important; }
        [data-bs-theme="dark"] .drop-zone { background: #1a1d21; border-color: #495057; }
        [data-bs-theme="dark"] .drop-zone:hover, [data-bs-theme="dark"] .drop-zone.drag-over { background: #212529; border-color: #60a5fa; }
        [data-bs-theme="dark"] .step-card { background: #212529; }
        [data-bs-theme="dark"] .cta-btn, [data-bs-theme="dark"] .btn-analyze { background: #1e3a5f; color: #bfdbfe; border-color: #2d4a6f; }
        [data-bs-theme="dark"] .cta-btn:hover, [data-bs-theme="dark"] .btn-analyze:hover { background: #2d4a6f; color: #dbeafe; }
        [data-bs-theme="dark"] .btn-analyze:disabled { background: #1e3a5f; color: #bfdbfe; border-color: #2d4a6f; opacity: 0.8; }
        [data-bs-theme="dark"] .btn-analyze .spinner-border { color: #bfdbfe; }
        [data-bs-theme="dark"] .btn-analyze #tipText { color: #bfdbfe; }
        [data-bs-theme="dark"] .btn-analyze.pulse-highlight { background: #2d4a6f !important; color: #bfdbfe !important; }
        [data-bs-theme="dark"] .drop-zone .drop-text { color: #adb5bd; }
        [data-bs-theme="dark"] .drop-zone .drop-text .text-primary { color: #60a5fa !important; }
        [data-bs-theme="dark"] .drop-zone .file-name { color: #bfdbfe; }
        [data-bs-theme="dark"] .drop-zone .drop-icon { color: #60a5fa; }
        [data-bs-theme="dark"] .file-input-group label { color: #adb5bd; }
        [data-bs-theme="dark"] .file-input-group .form-text { color: #6c757d; }
        [data-bs-theme="dark"] .sample-callout { background: #1a2332 !important; border-color: #2d4a6f !important; }
        [data-bs-theme="dark"] .sample-callout small { color: #adb5bd !important; }
        [data-bs-theme="dark"] .btn-outline-dark { color: #adb5bd; border-color: #495057; }
        [data-bs-theme="dark"] .btn-outline-dark:hover { color: #fff; background: #495057; border-color: #495057; }
        .theme-toggle { cursor: pointer; font-size: 1.2rem; padding: 0.25rem 0.5rem; border: none; background: none; color: inherit; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">PolicyProof</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Analysis" asp-action="Upload">Upload</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <button class="theme-toggle" id="themeToggle" title="Toggle dark mode">
                        <i class="bi bi-moon-fill"></i>
                    </button>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid">
            &copy; 2026 - PolicyProof - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function() {
            var btn = document.getElementById('themeToggle');
            var t = localStorage.getItem('theme') || 'light';
            btn.querySelector('i').className = t === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
            btn.addEventListener('click', function() {
                var html = document.documentElement;
                var current = html.getAttribute('data-bs-theme');
                var next = current === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-bs-theme', next);
                localStorage.setItem('theme', next);
                btn.querySelector('i').className = next === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
